# One endpoint must serve Solana JSON-RPC, the Photon compression index and the prover.
# Public api.devnet.solana.com does NOT work — it has no compression index.
NEXT_PUBLIC_RPC_URL="https://devnet.helius-rpc.com/?api-key=..."

# Only for a local `light test-validator`, which puts the three roles on three ports.
# Against a hosted ZK-compression RPC, leave both unset and they follow NEXT_PUBLIC_RPC_URL.
# NEXT_PUBLIC_PHOTON_URL="http://127.0.0.1:8784"
# NEXT_PUBLIC_PROVER_URL="http://127.0.0.1:3001"

# The admin whose treasury this deployment bills against (scripts/init-treasury.ts prints it).
NEXT_PUBLIC_TREASURY_ADMIN=""

# Devnet USDC. Mainnet is EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v.
NEXT_PUBLIC_USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# "devnet" | "mainnet-beta" | "localnet" — used for explorer links only.
NEXT_PUBLIC_CLUSTER="devnet"

# Optional overrides; both default to the ids baked into the SDK's IDLs.
# NEXT_PUBLIC_LATH_PROGRAM_ID=""
# NEXT_PUBLIC_BILLING_PROGRAM_ID=""
