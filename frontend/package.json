{
  "name": "@lath/app",
  "version": "0.1.0",
  "private": true,
  "description": "Wallet-gated web app over the Lath SDK: agents, loops, allowances and the billing vault",
  "scripts": {
    "dev": "../scripts/dev-devnet.sh",
    "dev:devnet": "../scripts/dev-devnet.sh",
    "dev:full": "../scripts/dev-devnet.sh --build",
    "build": "npm --prefix ../sdk run build && npm --prefix ../runtime run build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@irys/upload": "0.0.15",
    "@irys/upload-solana": "0.1.8",
    "@lath/runtime": "file:../runtime",
    "@lath/sdk": "file:../sdk",
    "@lightprotocol/stateless.js": "0.23.3",
    "@noble/curves": "^2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "^5.59.0",
    "mppx": "^0.10.1",
    "next": "^15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "2.56.5"
  },
  "overrides": {
    "axios": ">=1.19.1",
    "mppx": {
      "next": "$next"
    },
    "ws": "^8.20.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0"
  }
}
