diff --git a/src/lath.rs b/src/lath.rs
new file mode 100644
index 0000000..d7e64b5
--- /dev/null
+++ b/src/lath.rs
@@ -0,0 +1,141 @@
+//! The Lath build's one command: `zeroclaw agent -a <alias> -m <message>`.
+//!
+//! A Lath host runs each loop step as one invocation of this binary, with a
+//! config directory it wrote for that step, under a wrapper that leaves the
+//! process two Unix sockets and its workspace. This module is the whole of
+//! what the binary does with that invocation: check that the config is the
+//! posture the host committed, run one agent turn through the full agent loop,
+//! print the final text on stdout, and exit. Anything the host did not ask for
+//! is refused with a message that names it, because a step that quietly runs
+//! with a wider posture than its committed one is worse than a failed step.
+
+use anyhow::{Result, bail};
+use std::path::PathBuf;
+use zeroclaw_config::schema::Config;
+
+/// The `agent` subcommand's arguments, as the CLI parsed them.
+#[derive(Debug, Clone, Default)]
+pub struct AgentArgs {
+    pub agent: String,
+    pub message: Option<String>,
+    pub session_state_file: Option<PathBuf>,
+    pub model_provider: Option<String>,
+    pub model: Option<String>,
+    pub temperature: Option<f64>,
+    pub peripheral: Vec<String>,
+}
+
+/// Refuse the parts of the `agent` command line a Lath step never uses.
+///
+/// Each would widen the run: interactive mode reads a terminal the host does
+/// not attach, a session file is a write outside the room's two directories,
+/// and a peripheral opens a device.
+pub fn check_args(args: &AgentArgs) -> Result<()> {
+    if args.message.is_none() {
+        bail!(
+            "lath: `agent` needs `-m <message>`: the Lath build runs one turn and has no \
+             interactive mode"
+        );
+    }
+    if let Some(path) = &args.session_state_file {
+        bail!(
+            "lath: refused `--session-state-file {}`: a step keeps no session outside its \
+             config directory",
+            path.display()
+        );
+    }
+    if let Some(board) = args.peripheral.first() {
+        bail!("lath: refused `--peripheral {board}`: the Lath build opens no device");
+    }
+    Ok(())
+}
+
+/// Check the step's posture, then run its one turn.
+pub async fn run_agent(config: Config, args: AgentArgs) -> Result<()> {
+    check_args(&args)?;
+    if config.agent(&args.agent).is_none() {
+        bail!(
+            "`zeroclaw agent --agent {}` is not configured (no [agents.{}] entry)",
+            args.agent,
+            args.agent
+        );
+    }
+    zeroclaw_providers::lath::check_config(&config, args.model_provider.as_deref())?;
+
+    let temperature = args.temperature.or_else(|| {
+        config
