--- /dev/null
+++ b/crates/zeroclaw-providers/src/lath.rs
@@ -0,0 +1,284 @@
+//! The Lath build's provider posture: one `custom` provider, and nothing else.
+//!
+//! Every provider family stays linked in the Lath build, because the families
+//! share helpers `custom` needs (`compatible.rs` uses `anthropic::CacheControl`,
+//! `models_dev` and `openrouter_catalog`; `reliable.rs` names the Anthropic
+//! provider). So the other families are refused where they would be built
+//! rather than compiled out:
+//!
+//! - [`check_construction`] runs at the top of `create_model_provider_inner`,
+//!   the single function every provider construction passes through, so a
+//!   fallback, a route or a model switch that reaches a second family mid-turn
+//!   fails there;
+//! - [`check_config`] walks, at startup, every place the config or the command
+//!   line can name a provider, so a misconfigured step fails before its first
+//!   request with the offending key in the error, instead of on the one path
+//!   that happens to reach it.
+//!
+//! Every refusal names what it refused: the host turns a non-zero exit into a
+//! failed step and shows the message, so the message is the diagnosis.
+
+use anyhow::{Result, bail};
+use zeroclaw_config::schema::{Config, WireApi};
+
+/// The only provider family the Lath build constructs.
+pub const LATH_PROVIDER_FAMILY: &str = "custom";
+
+/// Refuse a provider construction the Lath build does not allow.
+///
+/// `raw_name` is the name as the caller passed it (a legacy `custom:<url>`
+/// still carries its colon here), `provider_kind` the canonical family after
+/// any `kind` override, and `wire_api` the resolved wire protocol.
+pub fn check_construction(
+    raw_name: &str,
+    provider_kind: &str,
+    wire_api: Option<&str>,
+) -> Result<()> {
+    // `custom:https://…` names an endpoint in the provider name itself, which
+    // no config key records and the startup walk cannot see.
+    if raw_name.contains(':') {
+        bail!(
+            "lath: refused model provider `{raw_name}`: the legacy `<family>:<url>` form is not \
+             accepted; configure `[providers.models.custom.<alias>]` instead"
+        );
+    }
+    if provider_kind != LATH_PROVIDER_FAMILY {
+        bail!(
+            "lath: refused model provider `{provider_kind}`: the Lath build reaches the model \
+             only through one `custom` provider"
+        );
+    }
+    if wire_api == Some(WireApi::Responses.as_str()) {
+        bail!(
+            "lath: refused `wire_api = \"responses\"` on `{raw_name}`: the Lath build speaks \
+             chat completions only"
+        );
+    }
+    Ok(())
+}
+
+/// Walk every provider the config or the command line can name, and refuse
+/// the first one the Lath build would not construct.
+///
+/// `provider_override` is `agent -p`: the host never passes it, so any value
+/// is refused rather than resolved.
+pub fn check_config(config: &Config, provider_override: Option<&str>) -> Result<()> {
+    if let Some(p) = provider_override {
+        bail!(
+            "lath: refused `--model-provider {p}`: the provider is the agent's own, from \
+             config, and is not overridden on the command line"
+        );
+    }
+    for (family, alias, entry) in config.providers.models.iter_entries() {
+        if family != LATH_PROVIDER_FAMILY {
+            bail!(
+                "lath: refused provider `providers.models.{family}.{alias}`: the Lath build \
+                 reaches the model only through one `custom` provider"
+            );
+        }
+        if let Some(kind) = entry
+            .kind
+            .as_deref()
+            .map(str::trim)
+            .filter(|k| !k.is_empty())
+            && crate::canonicalize_v2_model_provider_name(kind) != LATH_PROVIDER_FAMILY
+        {
+            bail!("lath: refused `providers.models.{family}.{alias}.kind = \"{kind}\"`");
+        }
+        if let Some(first) = entry.fallback.first() {
+            bail!(
+                "lath: refused fallback `{first}` on `providers.models.{family}.{alias}`: \
+                 a step has one provider and no fallback"
+            );
+        }
+        if let Some(first) = entry.fallback_models.first() {
+            bail!(
+                "lath: refused fallback model `{first}` on `providers.models.{family}.{alias}`: \
+                 a step has one model and no fallback"
+            );
+        }
+        if entry.wire_api == Some(WireApi::Responses) {
+            bail!(
+                "lath: refused `providers.models.{family}.{alias}.wire_api = \"responses\"`: \
+                 the Lath build speaks chat completions only"
+            );
+        }
+    }
+    if let Some(route) = config.model_routes.first() {
+        bail!(
+            "lath: refused model route `{}` (to `{}`): a step has one provider and no routes",
+            route.hint,
+            route.model_provider
+        );
+    }
+    if let Some(route) = config.embedding_routes.first() {
+        bail!(
+            "lath: refused embedding route `{}` (to `{}`): a step has one provider and no routes",
+            route.hint,
+            route.model_provider
+        );
+    }
+    if let Some((family, alias, _)) = config.providers.tts.iter_entries().next() {
+        bail!("lath: refused provider `providers.tts.{family}.{alias}`");
+    }
+    if let Some((family, alias, _)) = config.providers.transcription.iter_entries().next() {
+        bail!("lath: refused provider `providers.transcription.{family}.{alias}`");
+    }
+    let mut agents: Vec<_> = config.agents.iter().collect();
+    agents.sort_by(|a, b| a.0.cmp(b.0));
+    for (alias, agent) in agents {
+        let reference = agent.model_provider.as_str();
+        let family = reference.split_once('.').map_or(reference, |(f, _)| f);
+        if family != LATH_PROVIDER_FAMILY {
+            bail!(
+                "lath: refused `agents.{alias}.model_provider = \"{reference}\"`: the Lath build \
+                 reaches the model only through one `custom` provider"
+            );
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zeroclaw_config::schema::{AliasedAgentConfig, ModelRouteConfig};
+
+    /// The CONTRACT shape: one `custom.lath` provider, one agent on it.
+    fn lath_config() -> Config {
+        let mut cfg = Config::default();
+        let entry = cfg.providers.models.ensure("custom", "lath").unwrap();
+        entry.model = Some("m".into());
+        entry.uri = Some("http://localhost/v1".into());
+        let agent = AliasedAgentConfig {
+            model_provider: "custom.lath".into(),
+            ..AliasedAgentConfig::default()
+        };
+        cfg.agents.insert("lath".into(), agent);
+        cfg
+    }
+
+    #[test]
+    fn construction_accepts_custom() {
+        check_construction("custom", "custom", None).unwrap();
+        check_construction("custom", "custom", Some("chat_completions")).unwrap();
+    }
+
+    #[test]
+    fn construction_refuses_every_other_family_by_name() {
+        for family in ["openrouter", "openai", "anthropic", "ollama", "gemini"] {
+            let err = check_construction(family, family, None)
+                .unwrap_err()
+                .to_string();
+            assert!(err.contains(family), "{err}");
+        }
+    }
+
+    #[test]
+    fn construction_refuses_the_legacy_url_form() {
+        let err = check_construction("custom:https://evil.example", "custom", None)
+            .unwrap_err()
+            .to_string();
+        assert!(err.contains("custom:https://evil.example"), "{err}");
+    }
+
+    #[test]
+    fn construction_refuses_the_responses_wire() {
+        let err = check_construction("custom", "custom", Some("responses"))
+            .unwrap_err()
+            .to_string();
+        assert!(err.contains("responses"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_accepts_one_custom_provider() {
+        check_config(&lath_config(), None).unwrap();
+    }
+
+    #[test]
+    fn config_walk_refuses_a_second_family() {
+        let mut cfg = lath_config();
+        cfg.providers
+            .models
+            .ensure("openrouter", "default")
+            .unwrap();
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("providers.models.openrouter.default"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_a_fallback() {
+        let mut cfg = lath_config();
+        let entry = cfg.providers.models.ensure("custom", "lath").unwrap();
+        entry.fallback = vec!["custom.other".into()];
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("custom.other"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_a_fallback_model() {
+        let mut cfg = lath_config();
+        let entry = cfg.providers.models.ensure("custom", "lath").unwrap();
+        entry.fallback_models = vec!["other-model".into()];
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("other-model"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_a_route() {
+        let mut cfg = lath_config();
+        cfg.model_routes.push(ModelRouteConfig {
+            hint: "fast".into(),
+            model_provider: "openrouter.default".into(),
+            model: "x".into(),
+            api_key: None,
+        });
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("fast"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_the_responses_wire() {
+        let mut cfg = lath_config();
+        let entry = cfg.providers.models.ensure("custom", "lath").unwrap();
+        entry.wire_api = Some(WireApi::Responses);
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("wire_api"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_a_kind_override() {
+        let mut cfg = lath_config();
+        let entry = cfg.providers.models.ensure("custom", "lath").unwrap();
+        entry.kind = Some("openrouter".into());
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("openrouter"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_an_agent_on_another_family() {
+        let mut cfg = lath_config();
+        cfg.agents.get_mut("lath").unwrap().model_provider = "openrouter.default".into();
+        let err = check_config(&cfg, None).unwrap_err().to_string();
+        assert!(err.contains("openrouter.default"), "{err}");
+    }
+
+    #[test]
+    fn config_walk_refuses_a_command_line_provider() {
+        let err = check_config(&lath_config(), Some("openrouter"))
+            .unwrap_err()
+            .to_string();
+        assert!(err.contains("openrouter"), "{err}");
+    }
+
+    #[test]
+    fn the_walk_sees_custom_entries_under_the_family_the_construction_check_uses() {
+        let families: Vec<_> = lath_config()
+            .providers
+            .models
+            .iter_entries()
+            .map(|e| e.0)
+            .collect();
+        assert_eq!(families, vec![LATH_PROVIDER_FAMILY]);
+    }
+}
