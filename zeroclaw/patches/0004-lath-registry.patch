@@ -0,0 +1,445 @@
+//! The Lath registry: every tool a binary built with the `lath` feature can
+//! offer a model, and nothing else.
+//!
+//! Eight tools. Two are ZeroClaw's own and run in the process, inside the
+//! agent's workspace: `file_read` and `file_write`. Six are the Lath host's,
+//! compiled in as thin clients of one HTTP/1.1 listener on a Unix socket the
+//! host created for the step (`[lath] tools_socket`): `store_get`,
+//! `store_set`, `solana_slot`, `solana_fees`, `solana_balance` and
+//! `lath_verify_chain`. The host runs each call through the same code path an
+//! in-process Lath tool call takes, and records it on its chain.
+//!
+//! The wire names are the ones the Lath runtime already sends for these tool
+//! ids (a dot becomes `_`), and each description and parameter schema is
+//! copied verbatim from the Lath definitions, so the model sees the same spec
+//! whether a step runs in the sandbox or not. A Lath-side test compares them.
+//!
+//! The protocol (Lath `zeroclaw/CONTRACT.md` §3): `POST /tools/<tool id>` with
+//! `Authorization: Bearer <tools_token>` and the model's arguments as the
+//! JSON body. `200 {"result": …}` is a successful result, `404`/`500
+//! {"error": …}` a failed one the model sees, and anything else (a `401`, an
+//! unexpected status, a transport failure) an error of the call itself.
+
+use std::path::Path;
+use std::sync::Arc;
+
+use anyhow::{Context, Result, bail};
+use async_trait::async_trait;
+use serde_json::Value;
+use zeroclaw_api::attribution::ToolKind;
+use zeroclaw_api::tool::ToolOutput;
+use zeroclaw_api::tool_attribution;
+
+use crate::platform::RuntimeAdapter;
+use crate::security::SecurityPolicy;
+use crate::tools::{
+    AllToolsResult, FileReadTool, FileWriteTool, PathGuardedTool, RateLimitedTool, Tool, ToolResult,
+};
+
+/// ZeroClaw's own tools in the Lath registry, run in-process.
+pub const LATH_FILE_TOOLS: [&str; 2] = ["file_read", "file_write"];
+
+/// One host tool: the name the model calls, the id the host records, and the
+/// spec the model is shown.
+#[derive(Debug, Clone, Copy)]
+pub struct HostToolDef {
+    /// The name the model sees and calls (`store_get`).
+    pub wire_name: &'static str,
+    /// The dotted Lath tool id, and the request path (`store.get`).
+    pub id: &'static str,
+    /// Verbatim from the Lath definition.
+    pub description: &'static str,
+    /// Verbatim from the Lath definition, as JSON text. A Lath tool with no
+    /// `parameters` is sent as an empty object schema, as the Lath runtime
+    /// sends it.
+    pub parameters: &'static str,
+}
+
+/// The six host tools, in the order the Lath contract lists them.
+pub const LATH_HOST_TOOLS: [HostToolDef; 6] = [
+    HostToolDef {
+        wire_name: "store_get",
+        id: "store.get",
+        description: "Reads your key-value store, which persists across sessions and loop steps and which your owner can also write. Pass key to read one value; omit it to list every key.",
+        parameters: r#"{"type":"object","properties":{"key":{"type":"string"}}}"#,
+    },
+    HostToolDef {
+        wire_name: "store_set",
+        id: "store.set",
+        description: "Writes a value under a key in your store, on chain. Public: anyone can read it. Keys are 1–64 of A-Z a-z 0-9 . _ : - ; values are text up to 1024 bytes. Each write costs a chain transaction, so write what should outlast this run, not scratch work.",
+        parameters: r#"{"type":"object","properties":{"key":{"type":"string"},"value":{"type":"string"}},"required":["key","value"]}"#,
+    },
+    HostToolDef {
+        wire_name: "solana_slot",
+        id: "solana.slot",
+        description: "The cluster's current slot and block time.",
+        parameters: r#"{"type":"object","properties":{}}"#,
+    },
+    HostToolDef {
+        wire_name: "solana_fees",
+        id: "solana.fees",
+        description: "Recent prioritization fees, so a write can be priced.",
+        parameters: r#"{"type":"object","properties":{}}"#,
+    },
+    HostToolDef {
+        wire_name: "solana_balance",
+        id: "solana.balance",
+        description: "Lamports held by an address.",
+        parameters: r#"{"type":"object","properties":{"address":{"type":"string"}},"required":["address"]}"#,
+    },
+    HostToolDef {
+        wire_name: "lath_verify_chain",
+        id: "lath.verify_chain",
+        description: "Replays a hash chain from the indexer and reports whether it holds, plus any records of it still anchoring. Defaults to your own chain; pass agentId to verify another agent's.",
+        parameters: r#"{"type":"object","properties":{"agentId":{"type":"string"}}}"#,
+    },
+];
+
+/// Every name the Lath registry can hold: the two file tools, then the six
+/// host tools.
+pub fn lath_tool_names() -> impl Iterator<Item = &'static str> {
+    LATH_FILE_TOOLS
+        .into_iter()
+        .chain(LATH_HOST_TOOLS.iter().map(|t| t.wire_name))
+}
+
+/// Whether `name` is one of the eight.
+pub fn is_lath_tool(name: &str) -> bool {
+    lath_tool_names().any(|n| n == name)
+}
+
+/// Refuse a registry that holds any name outside the eight.
+///
+/// Run on the assembled registry, after every stage that could add a tool
+/// (peripherals, pipeline, MCP, skills), so a tool that reaches the model by
+/// a path this module does not know about stops the run instead.
+pub fn check_registry<'a>(names: impl IntoIterator<Item = &'a str>) -> Result<()> {
+    for name in names {
+        if !is_lath_tool(name) {
+            bail!(
+                "lath: refused tool `{name}` in the assembled registry: the Lath build offers \
+                 only {}",
+                lath_tool_names().collect::<Vec<_>>().join(", ")
+            );
+        }
+    }
+    Ok(())
+}
+
+/// The client every host tool shares: one HTTP/1.1 client bound to the
+/// step's tools socket, and the step's token.
+#[derive(Clone)]
+pub struct HostToolsClient {
+    client: reqwest::Client,
+    token: String,
+}
+
+impl HostToolsClient {
+    /// Build the client for an absolute socket path and a non-empty token.
+    ///
+    /// Like the provider's socket client, it ignores `HTTP_PROXY` and friends,
+    /// follows no redirect and resolves no name: reqwest sends every
+    /// connection to the socket whatever host the URL names.
+    pub fn connect(socket: &Path, token: &str) -> Result<Self> {
+        if !socket.is_absolute() {
+            bail!(
+                "lath: refused `lath.tools_socket = \"{}\"`: the socket path must be absolute",
+                socket.display()
+            );
+        }
+        if token.trim().is_empty() {
+            bail!(
+                "lath: `lath.tools_token` is required: the host tool listener needs the step's token"
+            );
+        }
+        Ok(Self {
+            client: Self::client(socket)?,
+            token: token.to_string(),
+        })
+    }
+
+    #[cfg(unix)]
+    fn client(socket: &Path) -> Result<reqwest::Client> {
+        reqwest::Client::builder()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .connect_timeout(std::time::Duration::from_secs(10))
+            .timeout(std::time::Duration::from_secs(120))
+            .unix_socket(socket.to_path_buf())
+            .build()
+            .context("lath: building the host-tool socket client")
+    }
+
+    #[cfg(not(unix))]
+    fn client(socket: &Path) -> Result<reqwest::Client> {
+        bail!(
+            "lath: `lath.tools_socket = \"{}\"` needs a Unix platform",
+            socket.display()
+        )
+    }
+
+    /// Call host tool `id` with the model's arguments.
+    pub async fn call(&self, id: &str, args: &Value) -> Result<ToolResult> {
+        let response = self
+            .client
+            .post(format!("http://localhost/tools/{id}"))
+            .bearer_auth(&self.token)
+            .json(args)
+            .send()
+            .await
+            .with_context(|| format!("lath: host tool `{id}`: the tools socket did not answer"))?;
+        let status = response.status().as_u16();
+        let body = response
+            .bytes()
+            .await
+            .with_context(|| format!("lath: host tool `{id}`: reading the answer"))?;
+        interpret(id, status, &body)
+    }
+}
+
+/// Map one host answer onto a tool result, per the contract.
+fn interpret(id: &str, status: u16, body: &[u8]) -> Result<ToolResult> {
+    match status {
+        200 => {
+            let answer: Value = serde_json::from_slice(body)
+                .with_context(|| format!("lath: host tool `{id}`: the 200 body is not JSON"))?;
+            let Some(result) = answer.get("result") else {
+                bail!("lath: host tool `{id}`: the 200 body has no `result`");
+            };
+            // Compact, as the Lath runtime renders an in-process tool result.
+            let text = serde_json::to_string(result)?;
+            Ok(ToolResult::ok(ToolOutput::json_with_text(
+                result.clone(),
+                text,
+            )))
+        }
+        404 | 500 => {
+            let text = serde_json::from_slice::<Value>(body)
+                .ok()
+                .and_then(|v| v.get("error").and_then(Value::as_str).map(str::to_string))
+                .unwrap_or_else(|| String::from_utf8_lossy(body).into_owned());
+            Ok(ToolResult::err(text))
+        }
+        401 => bail!("lath: host tool `{id}`: the host refused this step's token (401)"),
+        other => bail!("lath: host tool `{id}`: unexpected status {other}"),
+    }
+}
+
+/// One host tool, as the model sees it.
+pub struct LathHostTool {
+    def: HostToolDef,
+    client: Arc<HostToolsClient>,
+}
+
+tool_attribution!(LathHostTool, ToolKind::Plugin);
+
+#[async_trait]
+impl Tool for LathHostTool {
+    fn name(&self) -> &str {
+        self.def.wire_name
+    }
+
+    fn description(&self) -> &str {
+        self.def.description
+    }
+
+    fn parameters_schema(&self) -> Value {
+        serde_json::from_str(self.def.parameters).expect("host tool parameters are JSON")
+    }
+
+    async fn execute(&self, args: Value) -> Result<ToolResult> {
+        self.client.call(self.def.id, &args).await
+    }
+}
+
+/// Build the Lath registry for `config`: the two file tools, guarded exactly
+/// as the full registry guards them, and the six host tools on
+/// `[lath] tools_socket`. The per-agent `allowed_tools` filter is applied
+/// afterwards by `ScopedToolRegistry::assemble`, as for every registry.
+pub fn lath_registry(
+    config: &zeroclaw_config::schema::Config,
+    security: &Arc<SecurityPolicy>,
+    runtime: &Arc<dyn RuntimeAdapter>,
+) -> Result<AllToolsResult> {
+    let socket = config
+        .lath
+        .tools_socket
+        .as_deref()
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .context(
+            "lath: `lath.tools_socket` is required: the Lath build serves its host tools there",
+        )?;
+    let token = config.lath.tools_token.as_deref().unwrap_or_default();
+    let client = Arc::new(HostToolsClient::connect(Path::new(socket), token)?);
+
+    let persistent_writes = runtime.has_filesystem_access();
+    let mut tools: Vec<Box<dyn Tool>> = vec![
+        Box::new(RateLimitedTool::new(
+            PathGuardedTool::new(
+                FileReadTool::new_with_persistence(security.clone(), persistent_writes),
+                security.clone(),
+            ),
+            security.clone(),
+        )),
+        Box::new(RateLimitedTool::new(
+            PathGuardedTool::new(
+                FileWriteTool::new_with_persistence(security.clone(), persistent_writes),
+                security.clone(),
+            ),
+            security.clone(),
+        )),
+    ];
+    for def in LATH_HOST_TOOLS {
+        tools.push(Box::new(LathHostTool {
+            def,
+            client: Arc::clone(&client),
+        }));
+    }
+    check_registry(tools.iter().map(|t| t.name()))?;
+    Ok(AllToolsResult::from_prebuilt_tools(tools))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_registry_names_are_exactly_the_eight() {
+        let names: Vec<_> = lath_tool_names().collect();
+        assert_eq!(
+            names,
+            [
+                "file_read",
+                "file_write",
+                "store_get",
+                "store_set",
+                "solana_slot",
+                "solana_fees",
+                "solana_balance",
+                "lath_verify_chain",
+            ]
+        );
+    }
+
+    #[test]
+    fn wire_names_are_the_ids_with_dots_as_underscores() {
+        for def in LATH_HOST_TOOLS {
+            assert_eq!(def.wire_name, def.id.replace('.', "_"));
+        }
+    }
+
+    #[test]
+    fn every_parameter_schema_is_an_object_schema() {
+        for def in LATH_HOST_TOOLS {
+            let schema: Value = serde_json::from_str(def.parameters).unwrap();
+            assert_eq!(schema["type"], "object", "{}", def.id);
+            assert!(schema["properties"].is_object(), "{}", def.id);
+        }
+    }
+
+    #[test]
+    fn a_name_outside_the_eight_is_refused_by_name() {
+        for name in [
+            "shell",
+            "http_request",
+            "web_fetch",
+            "github__create_issue",
+            "lattice_verify_chain",
+        ] {
+            let err = check_registry(["file_read", name]).unwrap_err().to_string();
+            assert!(err.contains(&format!("`{name}`")), "{err}");
+        }
+        check_registry(lath_tool_names()).unwrap();
+    }
+
+    #[test]
+    fn a_relative_tools_socket_is_refused() {
+        let err = HostToolsClient::connect(Path::new("t.sock"), "tok")
+            .err()
+            .unwrap()
+            .to_string();
+        assert!(err.contains("t.sock"), "{err}");
+    }
+
+    #[test]
+    fn an_empty_token_is_refused() {
+        let err = HostToolsClient::connect(Path::new("/tmp/t.sock"), " ")
+            .err()
+            .unwrap()
+            .to_string();
+        assert!(err.contains("tools_token"), "{err}");
+    }
+
+    #[test]
+    fn answers_map_onto_results_per_the_contract() {
+        let ok = interpret("store.get", 200, br#"{"result":{"found":false}}"#).unwrap();
+        assert!(ok.success);
+        assert_eq!(ok.output.data(), Some(&serde_json::json!({"found": false})));
+        assert_eq!(ok.output.as_str(), r#"{"found":false}"#);
+
+        let missing = interpret("store.get", 404, br#"{"error":"no such key"}"#).unwrap();
+        assert!(!missing.success);
+        assert_eq!(missing.error.as_deref(), Some("no such key"));
+
+        let failed = interpret("solana.slot", 500, br#"{"error":"rpc down"}"#).unwrap();
+        assert_eq!(failed.error.as_deref(), Some("rpc down"));
+
+        for (status, body) in [
+            (401, &b"{}"[..]),
+            (418, &b"{}"[..]),
+            (200, &b"{}"[..]),
+            (200, &b"not json"[..]),
+        ] {
+            assert!(interpret("store.get", status, body).is_err(), "{status}");
+        }
+    }
+
+    #[tokio::test]
+    #[cfg(unix)]
+    async fn a_host_tool_call_round_trips_over_the_socket() {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("t.sock");
+        let listener = tokio::net::UnixListener::bind(&path).unwrap();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut raw = Vec::new();
+            let mut buf = [0u8; 4096];
+            loop {
+                let n = stream.read(&mut buf).await.unwrap();
+                raw.extend_from_slice(&buf[..n]);
+                let text = String::from_utf8_lossy(&raw).to_string();
+                if let Some(end) = text.find("\r\n\r\n")
+                    && text[end + 4..].ends_with('}')
+                {
+                    break;
+                }
+                if n == 0 {
+                    break;
+                }
+            }
+            let body = r#"{"result":{"key":"k","found":true,"value":"v"}}"#;
+            let answer = format!(
+                "HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n{body}",
+                body.len()
+            );
+            stream.write_all(answer.as_bytes()).await.unwrap();
+            String::from_utf8_lossy(&raw).into_owned()
+        });
+        let client = Arc::new(HostToolsClient::connect(&path, "step-token").unwrap());
+        let tool = LathHostTool {
+            def: LATH_HOST_TOOLS[0],
+            client,
+        };
+        let result = tool.execute(serde_json::json!({"key": "k"})).await.unwrap();
+        assert!(result.success);
+        let request = server.await.unwrap();
+        assert!(
+            request.starts_with("POST /tools/store.get HTTP/1.1\r\n"),
+            "{request}"
+        );
+        assert!(request.contains("Bearer step-token"), "{request}");
+        assert!(request.ends_with(r#"{"key":"k"}"#), "{request}");
+    }
+}
