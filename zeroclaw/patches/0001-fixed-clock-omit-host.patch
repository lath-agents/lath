         // reachable. Omitted for shell-less runtimes.
         match &ctx.shell_profile {
             Some(profile) => Ok(format!(
-                "## Runtime\n\nHost: {host} | OS: {} | Shell: {} | Model: {}",
-                std::env::consts::OS,
-                profile.name,
-                ctx.model_name
-            )),
-            None => Ok(format!(
-                "## Runtime\n\nHost: {host} | OS: {} | Model: {}",
-                std::env::consts::OS,
-                ctx.model_name
+                "## Runtime\n\n{host_os}Shell: {} | Model: {}",
+                profile.name, ctx.model_name
             )),
+            None => Ok(format!("## Runtime\n\n{host_os}Model: {}", ctx.model_name)),
         }
     }
