+++ b/crates/zeroclaw-runtime/src/agent/clock.rs
@@ -0,0 +1,101 @@
+//! The runtime's notion of "now", and whether host facts reach the prompt.
+//!
+//! Every date or time the agent loop writes into a provider request goes
+//! through [`now`], so a host that needs byte-reproducible requests —
+//! replaying a recorded session, snapshot-testing a prompt, comparing eval
+//! runs across machines and days — can pin it with `ZEROCLAW_NOW`, an RFC 3339
+//! instant. Unset, it is the local clock, exactly as before.
+//!
+//! `ZEROCLAW_OMIT_HOST=1` leaves the hostname and OS out of the `## Runtime`
+//! section for the same reason: they are facts about the machine, not the
+//! session, and they differ between the run and its replay.
+//!
+//! Both are read from the environment rather than the config schema because
+//! they describe one invocation, not a deployment. Their uppercase names keep
+//! them out of the `ZEROCLAW_<lowercase>` config-override walker.
+
+use chrono::{DateTime, Local};
+use std::sync::OnceLock;
+
+/// Env var holding an RFC 3339 instant to use instead of the local clock.
+pub const NOW_ENV: &str = "ZEROCLAW_NOW";
+
+/// Env var that, set to `1` or `true`, omits hostname and OS from the prompt.
+pub const OMIT_HOST_ENV: &str = "ZEROCLAW_OMIT_HOST";
+
+/// The instant the runtime should treat as now.
+///
+/// The pinned value is read once per process: a run is one invocation, and
+/// re-reading the environment on every call would let a mid-run change split
+/// one session across two clocks. The result is rendered in the local time
+/// zone, so a caller that wants the offset pinned too sets `TZ`.
+pub fn now() -> DateTime<Local> {
+    static FIXED: OnceLock<Option<DateTime<Local>>> = OnceLock::new();
+    FIXED
+        .get_or_init(|| {
+            let raw = std::env::var(NOW_ENV).ok()?;
+            let parsed = parse_fixed(&raw);
+            if parsed.is_none() {
+                // A value that does not parse is a misconfiguration, not a
+                // request for the wall clock; say so rather than silently
+                // producing a run that cannot be reproduced.
+                eprintln!(
+                    "warning: {NOW_ENV}={raw:?} is not an RFC 3339 instant; using the local clock"
+                );
+            }
+            parsed
+        })
+        .unwrap_or_else(Local::now)
+}
+
+/// Whether the hostname and OS should be left out of the prompt.
+pub fn omit_host() -> bool {
+    std::env::var(OMIT_HOST_ENV).is_ok_and(|v| is_truthy(&v))
+}
+
+fn parse_fixed(raw: &str) -> Option<DateTime<Local>> {
+    DateTime::parse_from_rfc3339(raw.trim())
+        .ok()
+        .map(|t| t.with_timezone(&Local))
+}
+
+fn is_truthy(raw: &str) -> bool {
+    matches!(
+        raw.trim().to_ascii_lowercase().as_str(),
+        "1" | "true" | "yes"
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_an_rfc3339_instant() {
+        let t = parse_fixed("2026-09-24T12:00:00Z").expect("parses");
+        assert_eq!(t.timestamp(), 1_790_251_200);
+    }
+
+    #[test]
+    fn parses_with_an_offset_and_surrounding_space() {
+        let t = parse_fixed(" 2026-09-24T09:00:00-03:00 ").expect("parses");
+        assert_eq!(t.timestamp(), 1_790_251_200);
+    }
+
+    #[test]
+    fn rejects_what_is_not_rfc3339() {
+        assert!(parse_fixed("").is_none());
+        assert!(parse_fixed("2026-09-24").is_none());
+        assert!(parse_fixed("yesterday").is_none());
+    }
+
+    #[test]
+    fn truthy_values() {
+        for v in ["1", "true", "TRUE", " yes "] {
+            assert!(is_truthy(v), "{v:?}");
+        }
+        for v in ["", "0", "false", "no", "2"] {
+            assert!(!is_truthy(v), "{v:?}");
+        }
+    }
+}
