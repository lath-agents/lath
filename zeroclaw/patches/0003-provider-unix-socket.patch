+#[cfg(all(test, unix))]
+mod unix_socket_tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    /// A one-request HTTP/1.1 server on a Unix socket: returns the raw request
+    /// it read and answers with one chat-completion body.
+    async fn serve_once(listener: tokio::net::UnixListener) -> String {
+        let (mut stream, _) = listener.accept().await.expect("accept");
+        let mut raw = Vec::new();
+        let mut buf = [0u8; 8192];
+        loop {
+            let n = stream.read(&mut buf).await.expect("read");
+            raw.extend_from_slice(&buf[..n]);
+            let text = String::from_utf8_lossy(&raw);
+            if let Some(head_end) = text.find("\r\n\r\n") {
+                let length = text[..head_end]
+                    .lines()
+                    .find_map(|l| {
+                        l.to_ascii_lowercase()
+                            .strip_prefix("content-length:")
+                            .map(|v| v.trim().parse::<usize>().unwrap())
+                    })
+                    .unwrap_or(0);
+                if raw.len() >= head_end + 4 + length {
+                    break;
+                }
+            }
+            if n == 0 {
+                break;
+            }
+        }
+        let body = r#"{"choices":[{"message":{"content":"over the socket"}}]}"#;
+        let response = format!(
+            "HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n{body}",
+            body.len()
+        );
+        stream.write_all(response.as_bytes()).await.expect("write");
+        String::from_utf8_lossy(&raw).into_owned()
+    }
+
+    #[tokio::test]
+    async fn a_socket_provider_sends_its_request_over_the_socket() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("m.sock");
+        let listener = tokio::net::UnixListener::bind(&path).unwrap();
+        let server = tokio::spawn(serve_once(listener));
+        let clients = UnixSocketClients::connect(&path, 30, &Default::default()).unwrap();
+        let provider = OpenAiCompatibleModelProvider::builder("lath")
+            .display_name("Custom")
+            // The host is never resolved: reqwest connects to the socket.
+            .base_url("http://localhost/v1")
+            .credential(Some("step-token"))
+            .auth_style(AuthStyle::Bearer)
+            .unix_socket(clients)
+            .build();
+        let reply = provider
+            .chat_with_system(None, "hello", "m", Some(0.2))
+            .await
+            .unwrap();
+        assert_eq!(reply, "over the socket");
+        let request = server.await.unwrap();
+        assert!(
+            request.starts_with("POST /v1/chat/completions HTTP/1.1\r\n"),
+            "{request}"
+        );
+        assert!(
+            request.to_ascii_lowercase().contains("host: localhost"),
+            "{request}"
+        );
+        assert!(request.contains("Bearer step-token"), "{request}");
+    }
+
+    #[test]
+    fn a_relative_socket_path_is_refused() {
+        let err =
+            UnixSocketClients::connect(std::path::Path::new("m.sock"), 30, &Default::default())
+                .err()
+                .expect("relative path refused")
+                .to_string();
+        assert!(err.contains("m.sock"), "{err}");
+    }
+
+    #[test]
+    fn a_socket_with_the_responses_wire_is_refused_at_construction() {
+        use crate::factory::FamilyProviderFactory;
+        use zeroclaw_config::schema::{CustomModelProviderConfig, ModelProviderConfig, WireApi};
+        let cfg = CustomModelProviderConfig {
+            base: ModelProviderConfig {
+                wire_api: Some(WireApi::Responses),
+                ..Default::default()
+            },
+        };
+        let opts = crate::ModelProviderRuntimeOptions {
+            unix_socket: Some("/tmp/m.sock".into()),
+            ..Default::default()
+        };
+        let err = cfg
+            .create_provider("lath", None, Some("http://localhost/v1"), &opts)
+            .err()
+            .expect("refused")
+            .to_string();
+        assert!(err.contains("unix_socket"), "{err}");
+    }
+}
