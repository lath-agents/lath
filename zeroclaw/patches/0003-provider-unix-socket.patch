+/// The two HTTP clients of a provider that talks to a Unix socket instead of
+/// the network: one for request/response calls (bounded by the provider's
+/// timeout) and one for streams (bounded by the idle read timeout instead,
+/// like [`OpenAiCompatibleModelProvider::streaming_http_client`]).
+///
+/// Both are built once, when the provider is constructed, so a socket that
+/// cannot be configured is a construction error and never a silent fallback
+/// to a network client. Each ignores `HTTP_PROXY` and friends (`no_proxy`),
+/// follows no redirect, and does no DNS lookup: reqwest sends every
+/// connection to the socket whatever host the URL names.
+#[derive(Clone)]
+pub struct UnixSocketClients {
+    request: Client,
+    streaming: Client,
+}
+
+impl UnixSocketClients {
+    /// Build both clients for `path`, which must be absolute.
+    pub fn connect(
+        path: &std::path::Path,
+        timeout_secs: u64,
+        extra_headers: &std::collections::HashMap<String, String>,
+    ) -> anyhow::Result<Self> {
+        if !path.is_absolute() {
+            anyhow::bail!("unix_socket `{}` must be an absolute path", path.display());
+        }
+        let mut headers = HeaderMap::new();
+        for (key, value) in extra_headers {
+            let name = reqwest::header::HeaderName::from_bytes(key.as_bytes())
+                .map_err(|_| anyhow::Error::msg(format!("invalid extra header name `{key}`")))?;
+            let value = HeaderValue::from_str(value).map_err(|_| {
+                anyhow::Error::msg(format!("invalid value for extra header `{key}`"))
+            })?;
+            headers.insert(name, value);
+        }
+        let timeout =
+            std::time::Duration::from_secs(if timeout_secs > 0 { timeout_secs } else { 120 });
+        let request = Self::builder(path, headers.clone())?
+            .timeout(timeout)
+            .build()?;
+        let streaming = Self::builder(path, headers)?
+            .read_timeout(super::stream_idle_timeout(timeout_secs).duration())
+            .build()?;
+        Ok(Self { request, streaming })
+    }
+
+    #[cfg(unix)]
+    fn builder(path: &std::path::Path, headers: HeaderMap) -> anyhow::Result<ClientBuilder> {
+        Ok(Client::builder()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .connect_timeout(std::time::Duration::from_secs(10))
+            .default_headers(headers)
+            .unix_socket(path.to_path_buf()))
+    }
+
+    #[cfg(not(unix))]
+    fn builder(path: &std::path::Path, _headers: HeaderMap) -> anyhow::Result<ClientBuilder> {
+        anyhow::bail!("unix_socket `{}` needs a Unix platform", path.display())
+    }
+}
