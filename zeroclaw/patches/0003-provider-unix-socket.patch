+/// The prefix every Lath provider `uri` must carry. Over a Unix socket the
+/// host part is never resolved; it only fills the `Host` header, so it is
+/// pinned to one value rather than left to name a reachable machine.
+pub const LATH_PROVIDER_URI_PREFIX: &str = "http://localhost/";
+
+/// Refuse a `custom` provider that would not reach its endpoint over an
+/// absolute Unix socket, or whose `uri` names anything but the socket.
+pub fn check_socket_provider(alias: &str, unix_socket: Option<&str>, uri: &str) -> Result<()> {
+    let key = format!("providers.models.custom.{alias}");
+    let Some(socket) = unix_socket.map(str::trim).filter(|s| !s.is_empty()) else {
+        bail!(
+            "lath: `{key}.unix_socket` is required: the Lath build reaches its model over a \
+             Unix socket only"
+        );
+    };
+    if !std::path::Path::new(socket).is_absolute() {
+        bail!("lath: refused `{key}.unix_socket = \"{socket}\"`: the socket path must be absolute");
+    }
+    if !uri.trim().starts_with(LATH_PROVIDER_URI_PREFIX) {
+        bail!(
+            "lath: refused `{key}.uri = \"{uri}\"`: over the socket the uri must be \
+             `{LATH_PROVIDER_URI_PREFIX}<path>`, never a network address"
+        );
+    }
+    Ok(())
+}
