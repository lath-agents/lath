+/// The eight tool names a Lath posture may allow.
+pub const LATH_TOOLS: [&str; 8] = [
+    "file_read",
+    "file_write",
+    "store_get",
+    "store_set",
+    "solana_slot",
+    "solana_fees",
+    "solana_balance",
+    "lath_verify_chain",
+];
+
+/// The environment a step may carry beyond `HOME`, `TZ` and `LANG`: the two
+/// reproducibility knobs, and the config directory `--config-dir` exports.
+const ALLOWED_ZEROCLAW_ENV: [&str; 3] =
+    ["ZEROCLAW_NOW", "ZEROCLAW_OMIT_HOST", "ZEROCLAW_CONFIG_DIR"];
+
+/// Check a step's config against the one posture the Lath build runs: the
+/// shape of `zeroclaw/CONTRACT.md` §1 in the Lath repository, key for key.
+///
+/// It is an allow-list, not a deny-list: any key the contract does not name
+/// is refused, so an MCP server, a skill bundle, a channel, a delegate, a
+/// plugin, a web tool or a second agent is refused by the same rule as a
+/// typo. Values the posture fixes are checked too: one provider, over its
+/// socket, with a positive `context_window` when one is set; one agent, with
+/// memory `none`; a non-empty `allowed_tools` within the eight; approvals off
+/// at level `full`; no sandbox backend to detect; cost off; no retries; the
+/// host-tool socket and token.
+pub fn check_posture(raw: &toml::Table) -> Result<()> {
+    only(
+        raw,
+        "",
+        &[
+            "schema_version",
+            "locale",
+            "providers",
+            "agents",
+            "risk_profiles",
+            "runtime_profiles",
+            "memory",
+            "cost",
+            "reliability",
+            "lath",
+        ],
+    )?;
+    if raw.get("schema_version").and_then(toml::Value::as_integer) != Some(3) {
+        bail!("lath: `schema_version` must be 3");
+    }
+
+    let providers = table(raw, "providers", "providers")?;
+    only(providers, "providers", &["models"])?;
+    let models = table(providers, "models", "providers.models")?;
+    only(models, "providers.models", &["custom"])?;
+    let (provider_alias, provider) = single(models, "custom", "providers.models.custom")?;
+    let pkey = format!("providers.models.custom.{provider_alias}");
+    only(
+        provider,
+        &pkey,
+        &[
+            "model",
+            "uri",
+            "unix_socket",
+            "api_key",
+            "native_tools",
+            "temperature",
+            "context_window",
+        ],
+    )?;
+    for key in ["model", "uri", "unix_socket", "api_key"] {
+        string(provider, key, &pkey)?;
+    }
+    if provider.get("native_tools").and_then(toml::Value::as_bool) != Some(true) {
+        bail!("lath: `{pkey}.native_tools` must be true: the Lath tools are native tool calls");
+    }
+    // The host writes the model's real window here, per step; unset, upstream
+    // runs against its 32k compatibility fallback and refuses a turn above it
+    // before dispatch. Zero would silently mean that same fallback, and a
+    // float or a string is a host bug, so anything but a positive integer stops.
+    if let Some(window) = provider.get("context_window")
+        && window.as_integer().is_none_or(|n| n <= 0)
+    {
+        bail!(
+            "lath: refused `{pkey}.context_window = {window}`: it must be a positive integer, \
+             the model's context window in tokens"
+        );
+    }
+
+    let agents = table(raw, "agents", "agents")?;
+    let (agent_alias, agent) = single_entry(agents, "agents")?;
+    let akey = format!("agents.{agent_alias}");
+    only(
+        agent,
+        &akey,
+        &[
+            "enabled",
+            "model_provider",
+            "risk_profile",
+            "runtime_profile",
+            "workspace",
+            "memory",
+        ],
+    )?;
+    let expected_provider = format!("custom.{provider_alias}");
+    if string(agent, "model_provider", &akey)? != expected_provider {
+        bail!("lath: `{akey}.model_provider` must be `{expected_provider}`");
+    }
+    let workspace = table(agent, "workspace", &format!("{akey}.workspace"))?;
+    only(workspace, &format!("{akey}.workspace"), &["path"])?;
+    let path = string(workspace, "path", &format!("{akey}.workspace"))?;
+    if !Path::new(path).is_absolute() {
+        bail!(
+            "lath: refused `{akey}.workspace.path = \"{path}\"`: the workspace path must be absolute"
+        );
+    }
+    memory_none(agent, &akey)?;
+
+    let risk_name = string(agent, "risk_profile", &akey)?;
+    let risks = table(raw, "risk_profiles", "risk_profiles")?;
+    let (risk_alias, risk) = single_entry(risks, "risk_profiles")?;
+    if risk_alias != risk_name {
+        bail!("lath: `{akey}.risk_profile` must name `risk_profiles.{risk_alias}`");
+    }
+    let rkey = format!("risk_profiles.{risk_alias}");
+    only(
+        risk,
+        &rkey,
+        &[
+            "level",
+            "workspace_only",
+            "allowed_tools",
+            "always_ask",
+            "sandbox_enabled",
+        ],
+    )?;
+    if string(risk, "level", &rkey)? != "full" {
+        bail!("lath: `{rkey}.level` must be \"full\": a step has no one to ask for approval");
+    }
+    if risk.get("workspace_only").and_then(toml::Value::as_bool) != Some(true) {
+        bail!("lath: `{rkey}.workspace_only` must be true");
+    }
+    if risk.get("sandbox_enabled").and_then(toml::Value::as_bool) != Some(false) {
+        bail!(
+            "lath: `{rkey}.sandbox_enabled` must be false: the host's wrapper is the sandbox, \
+             and nothing is spawned to detect another"
+        );
+    }
+    if let Some(ask) = risk.get("always_ask")
+        && !ask.as_array().is_some_and(Vec::is_empty)
+    {
+        bail!("lath: `{rkey}.always_ask` must be empty: a step has no one to ask");
+    }
+    let tools = risk
+        .get("allowed_tools")
+        .and_then(toml::Value::as_array)
+        .with_context(|| format!("lath: `{rkey}.allowed_tools` is required"))?;
+    if tools.is_empty() {
+        bail!(
+            "lath: `{rkey}.allowed_tools` is empty, which upstream reads as unrestricted: \
+             name the tools the step may use"
+        );
+    }
+    let mut seen = std::collections::HashSet::new();
+    for tool in tools {
+        let name = tool
+            .as_str()
+            .with_context(|| format!("lath: `{rkey}.allowed_tools` holds a non-string"))?;
+        if !LATH_TOOLS.contains(&name) {
+            bail!(
+                "lath: refused tool `{name}` in `{rkey}.allowed_tools`: the Lath build offers \
+                 only {}",
+                LATH_TOOLS.join(", ")
+            );
+        }
+        if !seen.insert(name) {
+            bail!("lath: `{name}` appears twice in `{rkey}.allowed_tools`");
+        }
+    }
+
+    let runtime_name = string(agent, "runtime_profile", &akey)?;
+    let runtimes = table(raw, "runtime_profiles", "runtime_profiles")?;
+    let (runtime_alias, runtime) = single_entry(runtimes, "runtime_profiles")?;
+    if runtime_alias != runtime_name {
+        bail!("lath: `{akey}.runtime_profile` must name `runtime_profiles.{runtime_alias}`");
+    }
+    only(
+        runtime,
+        &format!("runtime_profiles.{runtime_alias}"),
+        &["max_tool_iterations"],
+    )?;
+
+    memory_none(raw, "")?;
+    let cost = table(raw, "cost", "cost")?;
+    only(cost, "cost", &["enabled"])?;
+    if cost.get("enabled").and_then(toml::Value::as_bool) != Some(false) {
+        bail!("lath: `cost.enabled` must be false: the host meters the step");
+    }
+    let reliability = table(raw, "reliability", "reliability")?;
+    only(reliability, "reliability", &["provider_retries"])?;
+    if reliability
+        .get("provider_retries")
+        .and_then(toml::Value::as_integer)
+        != Some(0)
+    {
+        bail!("lath: refused `reliability.provider_retries`: it must be 0");
+    }
+
+    let lath = table(raw, "lath", "lath")?;
+    only(lath, "lath", &["tools_socket", "tools_token"])?;
+    let socket = string(lath, "tools_socket", "lath")?;
+    if !Path::new(socket).is_absolute() {
+        bail!("lath: refused `lath.tools_socket = \"{socket}\"`: the socket path must be absolute");
+    }
+    string(lath, "tools_token", "lath")?;
+    Ok(())
+}
+
+/// Refuse the environment a step must not carry: any `ZEROCLAW_*` variable
+/// but the three the host sets. `ZEROCLAW_OPEN_SKILLS_*` would clone a
+/// repository and beats config upstream; any other `ZEROCLAW_<path>`
+/// overrides a config value after the posture was written.
+pub fn check_environment<I: IntoIterator<Item = String>>(names: I) -> Result<()> {
+    let mut names: Vec<String> = names.into_iter().collect();
+    names.sort();
+    for name in names {
+        if name.starts_with("ZEROCLAW_") && !ALLOWED_ZEROCLAW_ENV.contains(&name.as_str()) {
+            bail!(
+                "lath: refused environment variable `{name}`: a step's environment is HOME, TZ, \
+                 LANG, ZEROCLAW_NOW and ZEROCLAW_OMIT_HOST"
+            );
+        }
+    }
+    Ok(())
+}
+
+/// Refuse a workspace that holds a `skills/` entry: upstream loads it as
+/// workspace skills, and a skill can re-expose a shell or HTTP tool.
+pub fn check_workspace(workspace: &Path) -> Result<()> {
+    let skills = workspace.join("skills");
+    if skills.symlink_metadata().is_ok() {
+        bail!(
+            "lath: refused `{}`: the Lath build loads no skill, and a workspace skills \
+             directory would be one",
+            skills.display()
+        );
+    }
+    Ok(())
+}
+
+fn only(t: &toml::Table, prefix: &str, allowed: &[&str]) -> Result<()> {
+    let mut keys: Vec<&String> = t.keys().collect();
+    keys.sort();
+    for key in keys {
+        if !allowed.contains(&key.as_str()) {
+            if prefix.is_empty() {
+                bail!("lath: refused config key `{key}`: not part of the Lath posture");
+            }
+            bail!("lath: refused config key `{prefix}.{key}`: not part of the Lath posture");
+        }
+    }
+    Ok(())
+}
+
+fn table<'a>(t: &'a toml::Table, key: &str, name: &str) -> Result<&'a toml::Table> {
+    t.get(key)
+        .and_then(toml::Value::as_table)
+        .with_context(|| format!("lath: `[{name}]` is required"))
+}
+
+fn string<'a>(t: &'a toml::Table, key: &str, prefix: &str) -> Result<&'a str> {
+    t.get(key)
+        .and_then(toml::Value::as_str)
+        .filter(|s| !s.trim().is_empty())
+        .with_context(|| format!("lath: `{prefix}.{key}` is required"))
+}
+
+fn single_entry<'a>(t: &'a toml::Table, name: &str) -> Result<(&'a str, &'a toml::Table)> {
+    let mut entries = t.iter();
+    let Some((alias, value)) = entries.next() else {
+        bail!("lath: `[{name}]` needs exactly one entry");
+    };
+    if entries.next().is_some() {
+        let all: Vec<&str> = t.keys().map(String::as_str).collect();
+        bail!(
+            "lath: refused `{name}` with {} entries ({}): the Lath posture has exactly one",
+            all.len(),
+            all.join(", ")
+        );
+    }
+    let entry = value
+        .as_table()
+        .with_context(|| format!("lath: `{name}.{alias}` must be a table"))?;
+    Ok((alias.as_str(), entry))
+}
+
+fn single<'a>(t: &'a toml::Table, key: &str, name: &str) -> Result<(&'a str, &'a toml::Table)> {
+    single_entry(table(t, key, name)?, name)
+}
+
+fn memory_none(t: &toml::Table, prefix: &str) -> Result<()> {
+    let name = if prefix.is_empty() {
+        "memory".to_string()
+    } else {
+        format!("{prefix}.memory")
+    };
+    let memory = table(t, "memory", &name)?;
+    only(memory, &name, &["backend"])?;
+    if string(memory, "backend", &name)? != "none" {
+        bail!("lath: `{name}.backend` must be \"none\": the chain is the memory across steps");
+    }
+    Ok(())
+}
