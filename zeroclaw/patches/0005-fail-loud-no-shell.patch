new file mode 100644
index 0000000..fc9e2dc
--- /dev/null
+++ b/crates/zeroclaw-config/src/platform/lath.rs
@@ -0,0 +1,74 @@
+//! The Lath build's runtime adapter: the process itself, and no shell.
+//!
+//! A binary built with the `lath` feature gets this adapter from
+//! [`super::create_runtime`] whatever `[runtime]` says. It reports
+//! [`ShellDialect::None`], so nothing resolves or `stat`s a shell at startup
+//! (the Lath wrapper's sandbox profile has no rule for `/bin/sh`, and a
+//! lookup there is a denied syscall), the system prompt carries no `Shell:`,
+//! and any attempt to build a shell command is an error rather than a spawn.
+
+use super::{RuntimeAdapter, ShellDialect};
+use std::path::{Path, PathBuf};
+
+/// The shell-less runtime of the Lath build.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct LathRuntime;
+
+impl RuntimeAdapter for LathRuntime {
+    fn name(&self) -> &str {
+        "lath"
+    }
+
+    fn has_filesystem_access(&self) -> bool {
+        true
+    }
+
+    fn storage_path(&self) -> PathBuf {
+        directories::UserDirs::new().map_or_else(
+            || PathBuf::from(".zeroclaw"),
+            |u| u.home_dir().join(".zeroclaw"),
+        )
+    }
+
+    fn supports_long_running(&self) -> bool {
+        false
+    }
+
+    fn shell_dialect(&self) -> ShellDialect {
+        ShellDialect::None
+    }
+
+    fn build_shell_command(
+        &self,
+        command: &str,
+        _workspace_dir: &Path,
+    ) -> anyhow::Result<tokio::process::Command> {
+        let _ = command;
+        anyhow::bail!("lath: the Lath build has no shell and runs no command")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_lath_runtime_has_no_shell() {
+        let rt = LathRuntime;
+        assert!(!rt.has_shell_access());
+        assert_eq!(rt.shell_profile(), None);
+        assert!(rt.build_shell_command("echo hi", Path::new("/")).is_err());
+    }
+
+    #[cfg(feature = "lath")]
+    #[test]
+    fn the_lath_build_ignores_the_configured_shell() {
+        let cfg = crate::schema::RuntimeConfig {
+            shell: Some("/definitely/not/a/shell".into()),
+            ..crate::schema::RuntimeConfig::default()
+        };
+        let rt = super::super::create_runtime(&cfg).unwrap();
+        assert_eq!(rt.name(), "lath");
+        assert_eq!(rt.shell_profile(), None);
+    }
+}
